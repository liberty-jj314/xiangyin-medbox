# 换行规则：Windows 批处理必须是 CRLF，否则 goto 会失效
*.bat   text eol=crlf
*.cmd   text eol=crlf

# 代码与文档统一 LF
*.py    text eol=lf
*.js    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.csv   text eol=lf
*.txt   text eol=lf
*.svg   text eol=lf

# 二进制，不要动
*.mp3   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.ico   binary
*.zip   binary
